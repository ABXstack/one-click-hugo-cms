--- /dev/null
+++ b/site/layouts/partials/page-head.html
@@ -0,0 +1,13 @@
+{{/* Page title with a breadcrumb back to the parent section. */}}
+<div class="page-head">
+	<div class="wrap">
+		{{ $parent := .Parent }}
+		<p class="breadcrumb">
+			<a href="/">Home</a>
+			{{ if and $parent (not $parent.IsHome) }}
+				&nbsp;&rsaquo;&nbsp; <a href="{{ $parent.RelPermalink }}">{{ $parent.Title }}</a>
+			{{ end }}
+		</p>
+		<h1>{{ .Title }}</h1>
+	</div>
+</div>
diff --git a/site/layouts/partials/resources.html b/site/layouts/partials/resources.html
new file mode 100644
index 0000000..2511792
--- /dev/null
+++ b/site/layouts/partials/resources.html
@@ -0,0 +1,93 @@
+{{/*
+  Renders the `resources` front matter block.
+
+  Shape (two levels, both optional beyond `heading`):
+
+    resources:
+      - heading: "Section or group name"
+        intro:   ["paragraph", ...]
+        entries: [ {title, url, publisher, date, format, description, children} ]
+        notes:   ["markdown line", ...]
+        groups:  [ { same shape, one level down } ]
+
+  A block with `groups` renders as a section band; a block without
+  renders as a plain group. Descriptions run through markdownify so
+  inline links inside them survive.
+*/}}
+
+{{ define "sfc-entries" }}
+	<ul class="res-list">
+		{{ range . }}
+			<li class="entry">
+				<a class="entry-title" href="{{ .url }}">{{ .title }}</a>
+
+				{{ if or .publisher .date .format }}
+					<p class="entry-meta">
+						{{ with .publisher }}<span class="pub">{{ . }}</span>{{ end }}
+						{{ with .date }}<span>{{ . }}</span>{{ end }}
+						{{ with .format }}<span class="flag">{{ . }}</span>{{ end }}
+					</p>
+				{{ end }}
+
+				{{ with .description }}<p class="entry-desc">{{ . | markdownify }}</p>{{ end }}
+
+				{{ with .children }}
+					<ul class="entry-children">
+						{{ range . }}
+							<li>
+								<a class="entry-title" href="{{ .url }}">{{ .title }}</a>
+								{{ if or .publisher .format }}
+									<p class="entry-meta">
+										{{ with .publisher }}<span class="pub">{{ . }}</span>{{ end }}
+										{{ with .format }}<span class="flag">{{ . }}</span>{{ end }}
+									</p>
+								{{ end }}
+								{{ with .description }}<p class="entry-desc">{{ . | markdownify }}</p>{{ end }}
+							</li>
+						{{ end }}
+					</ul>
+				{{ end }}
+			</li>
+		{{ end }}
+	</ul>
+{{ end }}
+
+{{ define "sfc-group" }}
+	<section class="res-group">
+		<h2>{{ .heading }}</h2>
+
+		{{ with .intro }}
+			<div class="res-intro">
+				{{ range . }}<p>{{ . | markdownify }}</p>{{ end }}
+			</div>
+		{{ end }}
+
+		{{ with .entries }}{{ template "sfc-entries" . }}{{ end }}
+
+		{{ range .notes }}<p class="res-note">{{ . | markdownify }}</p>{{ end }}
+	</section>
+{{ end }}
+
+<div class="resources">
+	<div class="wrap">
+		{{ range .Params.resources }}
+			{{ if .groups }}
+				<section class="res-section">
+					<h2>{{ .heading }}</h2>
+
+					{{ with .intro }}
+						<div class="res-intro">
+							{{ range . }}<p>{{ . | markdownify }}</p>{{ end }}
+						</div>
+					{{ end }}
+
+					{{ with .entries }}{{ template "sfc-entries" . }}{{ end }}
+
+					{{ range .groups }}{{ template "sfc-group" . }}{{ end }}
+				</section>
+			{{ else }}
+				{{ template "sfc-group" . }}
+			{{ end }}
+		{{ end }}
+	</div>
+</div>
diff --git a/src/css/imports/_sfc.scss b/src/css/imports/_sfc.scss
new file mode 100644
index 0000000..7a6b8ce
--- /dev/null
+++ b/src/css/imports/_sfc.scss
@@ -0,0 +1,625 @@
+/* ============================================================
+   Seniors for Climate - British Columbia
+   Component styles.
+
+   Tachyons (the rest of this folder) is a utility layer: it only
+   styles elements you attach classes to. Markdown rendered through
+   {{ .Content }} carries no classes, which is why the resource pages
+   previously fell back to browser defaults. The .prose block below
+   styles that output.
+
+   Tokens live in _variables.scss.
+   ============================================================ */
+
+*, *::before, *::after { box-sizing: border-box; }
+
+
+
+a { color: var(--blue); }
+a:hover { color: var(--blue-deep); }
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+  border-radius: 2px;
+}
+
+img { max-width: 100%; height: auto; display: block; }
+
+.wrap { max-width: var(--page); margin: 0 auto; padding: 0 1.5rem; }
+.measure { max-width: var(--measure); }
+
+/* ------------------------------------------------------------
+   Masthead
+   ------------------------------------------------------------ */
+
+.masthead {
+  border-bottom: 1px solid var(--rule);
+  background: var(--paper);
+}
+
+.masthead-inner {
+  max-width: var(--page);
+  margin: 0 auto;
+  padding: 1rem 1.5rem;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+  flex-wrap: wrap;
+}
+
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 0.9rem;
+  text-decoration: none;
+}
+
+.brand img { height: 46px; width: auto; }
+
+.brand-region {
+  font-family: var(--font-serif);
+  font-size: 1.05rem;
+  font-weight: 600;
+  color: var(--green-deep);
+  padding-left: 0.9rem;
+  border-left: 2px solid var(--rule);
+  line-height: 1.15;
+  white-space: nowrap;
+}
+
+/* ------------------------------------------------------------
+   Navigation
+   ------------------------------------------------------------ */
+
+.nav ul { list-style: none; margin: 0; padding: 0; }
+
+.nav > ul {
+  display: flex;
+  align-items: center;
+  gap: 0.25rem;
+  flex-wrap: wrap;
+}
+
+.nav a {
+  display: block;
+  padding: 0.6rem 0.7rem;
+  font-size: 0.85rem;
+  font-weight: 600;
+  color: var(--ink);
+  text-decoration: none;
+  border-radius: 3px;
+  min-height: 44px;
+  display: flex;
+  align-items: center;
+}
+
+.nav a:hover,
+.nav a[aria-current="page"] {
+  color: var(--green-deep);
+  background: var(--band);
+}
+
+.nav a[aria-current="page"] { box-shadow: inset 0 -3px 0 var(--green); }
+
+.has-sub { position: relative; }
+
+.has-sub > a::after {
+  content: "";
+  width: 0.4em; height: 0.4em;
+  margin-left: 0.45em;
+  border-right: 2px solid currentColor;
+  border-bottom: 2px solid currentColor;
+  transform: translateY(-2px) rotate(45deg);
+}
+
+.sub {
+  position: absolute;
+  top: 100%; left: 0;
+  min-width: 20rem;
+  background: var(--paper);
+  border: 1px solid var(--rule);
+  border-top: 3px solid var(--green);
+  box-shadow: 0 8px 20px rgba(26, 29, 26, 0.13);
+  padding: 0.35rem;
+  z-index: 40;
+  display: none;
+}
+
+.has-sub:hover .sub,
+.has-sub:focus-within .sub { display: block; }
+
+.sub a { font-weight: 500; font-size: 0.8rem; white-space: normal; }
+
+/* Buttons */
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 48px;
+  padding: 0.7rem 1.25rem;
+  font-family: var(--font-sans);
+  font-size: 0.9rem;
+  font-weight: 700;
+  text-decoration: none;
+  border-radius: 3px;
+  border: 2px solid var(--green);
+  background: var(--green);
+  color: #FFFFFF;
+  transition: background-color 120ms ease, border-color 120ms ease;
+}
+
+.btn:hover { background: var(--green-deep); border-color: var(--green-deep); color: #FFFFFF; }
+
+.btn-quiet {
+  background: transparent;
+  color: var(--green-deep);
+}
+
+.btn-quiet:hover { background: var(--band); color: var(--green-deep); border-color: var(--green-deep); }
+
+.nav .btn { padding: 0.55rem 1rem; font-size: 0.8rem; min-height: 44px; }
+
+/* ------------------------------------------------------------
+   Hero — the type is the hero
+   ------------------------------------------------------------ */
+
+.hero {
+  background: var(--band);
+  border-bottom: 1px solid var(--band-deep);
+  padding: 4.5rem 0 4rem;
+}
+
+.hero h1 {
+  font-family: var(--font-serif);
+  font-size: clamp(2.8rem, 7vw, 4.6rem);
+  font-weight: 600;
+  line-height: 1.02;
+  letter-spacing: -0.02em;
+  margin: 0 0 1.25rem;
+  color: var(--green-deep);
+  max-width: 11ch;
+}
+
+.hero p {
+  font-size: 1.15rem;
+  line-height: 1.5;
+  max-width: 30rem;
+  margin: 0 0 2rem;
+  color: var(--ink);
+}
+
+.hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
+
+/* ------------------------------------------------------------
+   Sections
+   ------------------------------------------------------------ */
+
+.section { padding: 3.5rem 0; }
+.section-band { background: var(--band); border-block: 1px solid var(--band-deep); }
+
+.section h2 {
+  font-family: var(--font-serif);
+  font-size: 1.9rem;
+  font-weight: 600;
+  line-height: 1.15;
+  margin: 0 0 1rem;
+  color: var(--ink);
+}
+
+.section p { max-width: var(--measure); margin: 0 0 1rem; }
+
+.section ul { max-width: var(--measure); }
+
+.inline-link {
+  font-weight: 600;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 3px;
+}
+
+/* ------------------------------------------------------------
+   Directory — the homepage index of pages
+   Rows, not cards. Reads as a table of contents.
+   ------------------------------------------------------------ */
+
+.directory { margin: 0; padding: 0; list-style: none; max-width: none; }
+
+.dir-group + .dir-group { margin-top: 2.5rem; }
+
+.dir-group > h3 {
+  font-family: var(--font-sans);
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  color: var(--green-deep);
+  margin: 0 0 0.5rem;
+  padding-bottom: 0.4rem;
+  border-bottom: 2px solid var(--green);
+}
+
+.dir-row {
+  display: block;
+  padding: 1.1rem 0;
+  border-bottom: 1px solid var(--rule);
+  text-decoration: none;
+  color: inherit;
+}
+
+.dir-row:hover { background: var(--band); }
+.dir-row:hover .dir-title { color: var(--green-deep); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
+
+.dir-title {
+  font-family: var(--font-serif);
+  font-size: 1.2rem;
+  font-weight: 600;
+  color: var(--blue-deep);
+  display: block;
+  line-height: 1.25;
+}
+
+.dir-desc {
+  margin: 0.25rem 0 0;
+  color: var(--ink-muted);
+  font-size: 0.9rem;
+  max-width: 40rem;
+}
+
+/* ------------------------------------------------------------
+   Page header (interior pages)
+   ------------------------------------------------------------ */
+
+.page-head {
+  padding: 3rem 0 2rem;
+  border-bottom: 3px solid var(--green);
+}
+
+.breadcrumb {
+  font-size: 0.8rem;
+  color: var(--ink-muted);
+  margin: 0 0 0.75rem;
+}
+
+.breadcrumb a { color: var(--ink-muted); text-decoration-thickness: 1px; text-underline-offset: 2px; }
+.breadcrumb a:hover { color: var(--green-deep); }
+
+.page-head h1 {
+  font-family: var(--font-serif);
+  font-size: clamp(2.1rem, 5vw, 3.1rem);
+  font-weight: 600;
+  line-height: 1.08;
+  letter-spacing: -0.015em;
+  margin: 0;
+  color: var(--ink);
+  max-width: 20ch;
+}
+
+.page-intro {
+  padding: 2rem 0 0.5rem;
+}
+
+.page-intro p {
+  max-width: var(--measure);
+  margin: 0 0 1rem;
+}
+
+.page-intro p:first-child {
+  font-size: 1.15rem;
+  line-height: 1.5;
+  color: var(--ink);
+}
+
+/* ------------------------------------------------------------
+   Resource list — the core of this site
+   Annotated bibliography, not bullet points.
+   ------------------------------------------------------------ */
+
+.resources { padding: 1.5rem 0 4rem; }
+
+.res-group { margin-top: 2.75rem; }
+
+.res-group > h2 {
+  font-family: var(--font-sans);
+  font-size: 0.82rem;
+  font-weight: 700;
+  color: var(--green-deep);
+  margin: 0 0 0.25rem;
+  padding-bottom: 0.5rem;
+  border-bottom: 2px solid var(--green);
+}
+
+.res-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  max-width: 42rem;
+}
+
+.entry {
+  padding: 1.35rem 0 1.35rem 1.25rem;
+  border-bottom: 1px solid var(--rule);
+  border-left: 3px solid transparent;
+  transition: border-color 120ms ease, background-color 120ms ease;
+}
+
+.entry:hover { border-left-color: var(--green); background: #F7F9F2; }
+
+.entry-title {
+  font-family: var(--font-serif);
+  font-size: 1.15rem;
+  font-weight: 600;
+  line-height: 1.3;
+  color: var(--blue-deep);
+  text-decoration: underline;
+  text-decoration-color: var(--rule);
+  text-decoration-thickness: 2px;
+  text-underline-offset: 4px;
+  display: inline-block;
+}
+
+.entry-title:hover {
+  color: var(--blue);
+  text-decoration-color: var(--blue);
+}
+
+.entry-meta {
+  margin: 0.4rem 0 0;
+  font-size: 0.8rem;
+  color: var(--ink-muted);
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  flex-wrap: wrap;
+}
+
+.pub { font-weight: 600; color: var(--green-deep); }
+
+/* Format flag — shown only when clicking does something unexpected
+   (downloads a file, opens a video). Information, not decoration. */
+.flag {
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.03em;
+  padding: 0.1rem 0.45rem;
+  border: 1px solid var(--green);
+  border-radius: 2px;
+  color: var(--green-deep);
+  background: var(--band);
+}
+
+.entry-desc {
+  margin: 0.45rem 0 0;
+  color: var(--ink);
+  font-size: 0.92rem;
+  line-height: 1.55;
+  max-width: 36rem;
+}
+
+/* ------------------------------------------------------------
+   Callout — meeting / contact prompt
+   ------------------------------------------------------------ */
+
+.callout {
+  margin: 3rem 0 0;
+  padding: 1.75rem;
+  background: var(--band);
+  border-left: 5px solid var(--green);
+  max-width: 42rem;
+}
+
+.callout h2 {
+  font-family: var(--font-serif);
+  font-size: 1.3rem;
+  font-weight: 600;
+  margin: 0 0 0.5rem;
+  color: var(--green-deep);
+}
+
+.callout p { margin: 0 0 1rem; max-width: var(--measure); }
+.callout p:last-child { margin-bottom: 0; }
+
+/* ------------------------------------------------------------
+   Footer
+   ------------------------------------------------------------ */
+
+.site-footer {
+  background: var(--green-deep);
+  color: #EEF2E4;
+  padding: 3rem 0 2.5rem;
+  margin-top: 0;
+}
+
+.site-footer a { color: #FFFFFF; text-decoration-thickness: 1px; text-underline-offset: 3px; }
+.site-footer a:hover { color: #D8E6BE; }
+
+.footer-cols {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 2.5rem;
+  justify-content: space-between;
+}
+
+.footer-cols h3 {
+  font-family: var(--font-sans);
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0.03em;
+  margin: 0 0 0.75rem;
+  color: #C9DCA6;
+}
+
+.footer-cols ul { list-style: none; margin: 0; padding: 0; }
+.footer-cols li { margin-bottom: 0.4rem; }
+.footer-cols p { margin: 0 0 0.4rem; font-size: 0.9rem; }
+
+.footer-brand span {
+  font-family: var(--font-serif);
+  font-size: 1.25rem;
+  font-weight: 600;
+  color: #FFFFFF;
+  display: block;
+}
+
+/* ------------------------------------------------------------
+   Responsive
+   ------------------------------------------------------------ */
+
+/* Toggle button — hidden on desktop, where the menu is always visible. */
+.nav-toggle { display: none; }
+
+@media (max-width: 62rem) {
+  .masthead-inner { padding: 0.85rem 1.25rem; }
+  .nav > ul { gap: 0; }
+  .nav a { padding: 0.5rem 0.5rem; font-size: 0.78rem; }
+  .sub { position: static; display: block; box-shadow: none; border: 0; border-left: 3px solid var(--green); min-width: 0; padding: 0 0 0 0.5rem; margin-bottom: 0.5rem; }
+  .has-sub > a::after { display: none; }
+
+  .nav-toggle {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.55rem;
+    min-height: 48px;
+    padding: 0.6rem 1rem;
+    font-family: var(--font-sans);
+    font-size: 0.85rem;
+    font-weight: 700;
+    color: var(--green-deep);
+    background: var(--paper);
+    border: 2px solid var(--green);
+    border-radius: 3px;
+    cursor: pointer;
+  }
+
+  .nav-toggle-bars,
+  .nav-toggle-bars::before,
+  .nav-toggle-bars::after {
+    display: block;
+    width: 20px;
+    height: 2px;
+    background: currentColor;
+  }
+
+  .nav-toggle-bars { position: relative; }
+  .nav-toggle-bars::before { content: ""; position: absolute; top: -6px; }
+  .nav-toggle-bars::after  { content: ""; position: absolute; top: 6px; }
+
+  /* Collapsed by default; .is-open is applied by app.js */
+  .nav > ul { display: none; width: 100%; }
+  .nav > ul.is-open { display: flex; flex-direction: column; align-items: stretch; }
+  .nav { width: 100%; }
+}
+
+@media (max-width: 40rem) {
+  html { font-size: 18px; }
+  .wrap, .masthead-inner { padding-left: 1.1rem; padding-right: 1.1rem; }
+  .hero { padding: 3rem 0 2.5rem; }
+  .hero h1 { max-width: none; }
+  .nav > ul { flex-direction: column; align-items: stretch; }
+  .nav a { min-height: 48px; }
+  .btn { width: 100%; }
+  .entry { padding-left: 0.9rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * { transition: none !important; animation: none !important; }
+}
+
+/* ------------------------------------------------------------
+   Prose - styles markdown coming out of {{ .Content }},
+   which has no classes of its own.
+   ------------------------------------------------------------ */
+
+.prose { max-width: var(--measure); }
+
+.prose > p { margin: 0 0 1rem; }
+
+.prose > p:first-child { font-size: 1.15rem; line-height: 1.5; }
+
+.prose h2 {
+  font-family: var(--font-serif);
+  font-size: 1.6rem;
+  font-weight: 600;
+  line-height: 1.2;
+  margin: 2.25rem 0 0.75rem;
+  color: var(--ink);
+}
+
+.prose h3 {
+  font-family: var(--font-serif);
+  font-size: 1.25rem;
+  font-weight: 600;
+  line-height: 1.25;
+  margin: 1.75rem 0 0.5rem;
+  color: var(--ink);
+}
+
+.prose ul { padding-left: 1.15rem; margin: 0 0 1.25rem; }
+.prose li { margin-bottom: 0.5rem; }
+
+.prose a {
+  font-weight: 600;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 3px;
+}
+
+.prose strong { font-weight: 700; }
+
+/* ------------------------------------------------------------
+   Nested resource entries (a parent link with its own sub-links)
+   ------------------------------------------------------------ */
+
+.entry-children {
+  list-style: none;
+  margin: 0.85rem 0 0;
+  padding: 0 0 0 1.1rem;
+  border-left: 2px solid var(--rule);
+}
+
+.entry-children > li { margin-bottom: 0.75rem; }
+.entry-children > li:last-child { margin-bottom: 0; }
+.entry-children .entry-title { font-size: 1rem; }
+.entry-children .entry-desc { font-size: 0.87rem; }
+
+/* A group-level note: prose that sits with the entries but isn't one. */
+.res-note {
+  margin: 1rem 0 0;
+  padding-left: 1.25rem;
+  font-size: 0.9rem;
+  color: var(--ink-muted);
+  max-width: 36rem;
+}
+
+.res-note a { font-weight: 600; }
+
+/* Intro prose inside a resource group */
+.res-intro { max-width: var(--measure); margin: 0 0 1.25rem; padding-top: 0.75rem; }
+.res-intro p { margin: 0 0 0.75rem; }
+
+/* Section band heading (a group that contains sub-groups) */
+.res-section > h2 {
+  font-family: var(--font-serif);
+  font-size: 1.75rem;
+  font-weight: 600;
+  line-height: 1.2;
+  color: var(--green-deep);
+  margin: 3.25rem 0 0;
+  padding-bottom: 0.6rem;
+  border-bottom: 3px solid var(--green);
+}
+
+.res-section:first-child > h2 { margin-top: 2rem; }
+
+/* Skip link */
+.skip-link {
+  position: absolute;
+  left: -9999px;
+  top: 0;
+  background: var(--green-deep);
+  color: #FFFFFF;
+  padding: 0.75rem 1rem;
+  z-index: 100;
+  text-decoration: none;
+}
+
+.skip-link:focus { left: 0; }
